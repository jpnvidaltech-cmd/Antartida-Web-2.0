# ==============================================================================
# AntartidaLabs Web - Environment Configuration Example
# ==============================================================================

# Server Network Configuration
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000

# Security Secret (used for HMAC token generation and network rate limiting)
CONTACT_SECRET=clave_secreta_local_antartidalabs_2024

# Contact Email Addresses
CONTACT_RECIPIENT=contacto@antartidalabs.com
CONTACT_SENDER=no-reply@antartidalabs.com

# SMTP Transport Configuration (Optional)
# If SMTP_HOST is left empty, the server operates in local simulation mode
# and logs formatted emails to the console without returning an error.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
